# 应用标题
VITE_APP_TITLE=高速公路二次事故智能预警平台

# 应用命名空间
VITE_APP_NAMESPACE=vben-web-antd

VITE_BASE=/

# 接口地址（生产环境替换为实际后端地址）
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock服务，生产环境下关闭
VITE_NITRO_MOCK=false

# MQTT Broker 地址（生产环境替换为实际地址）
VITE_MQTT_BROKER=ws://127.0.0.1:9001

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
